<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#EBF8F3" /><stroke android:width="1dp" android:color="#129079" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FFFFFF" /><stroke android:width="1dp" android:color="#DCE7E3" /><corners android:radius="18dp" /></shape>
    </item>
</selector>

