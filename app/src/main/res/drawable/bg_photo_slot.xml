<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">

            <solid android:color="#EBF8F3" />

            <stroke
                android:width="2dp"
                android:color="#0F7667" />

            <corners android:radius="15dp" />

        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">

            <solid android:color="#EBF8F3" />

            <stroke
                android:width="2dp"
                android:color="#129079"
                android:dashWidth="7dp"
                android:dashGap="5dp" />

            <corners android:radius="15dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#F8FAF9" />

            <stroke
                android:width="2dp"
                android:color="#DCE7E3"
                android:dashWidth="7dp"
                android:dashGap="5dp" />

            <corners android:radius="15dp" />

        </shape>
    </item>

</selector>