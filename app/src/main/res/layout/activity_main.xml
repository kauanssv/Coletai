<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_screen"
    android:clipChildren="false"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="42dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <!-- Logo e nome -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Logo do Coletaí"
                    android:elevation="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_coletai" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coletaí"
                        android:textColor="@color/ink_900"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.08"
                        android:text="DESCARTE CONSCIENTE"
                        android:textColor="@color/ink_500"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Selo -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="38dp"
                android:background="@drawable/bg_kicker"
                android:drawableStart="@drawable/ic_leaf_small"
                android:drawablePadding="7dp"
                android:gravity="center_vertical"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="Tecnologia para um futuro limpo"
                android:textColor="@color/brand_800"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Título -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:lineSpacingExtra="2dp"
                android:text="Bom ter você&#10;por aqui."
                android:textColor="@color/ink_900"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Acesse sua conta para solicitar ou realizar uma coleta."
                android:textColor="@color/ink_500"
                android:textSize="14sp" />

            <!-- E-mail -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="E-mail"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="seu@email.com"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="15sp" />

            <!-- Senha -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Senha"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input">

                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="17dp"
                    android:paddingEnd="54dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnMostrarSenha"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:alpha="0.55"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar ou ocultar senha"
                    android:padding="14dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/ink_500" />

            </FrameLayout>

            <!-- Botão entrar -->

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:elevation="5dp"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Linha divisória -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="30dp"
                android:background="@color/line" />

            <!-- Cabeçalho do acesso rápido -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acesso rápido"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contas de demonstração"
                    android:textColor="@color/ink_500"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Cartões de demonstração -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardCliente"
                    style="@style/DemoCard"
                    android:layout_marginEnd="5dp">

                    <ImageView
                        style="@style/DemoIcon"
                        android:contentDescription="Cliente"
                        android:src="@drawable/ic_person"
                        app:tint="@color/brand_700" />

                    <TextView
                        style="@style/DemoLabel"
                        android:text="Cliente" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardAmbulante"
                    style="@style/DemoCard"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp">

                    <ImageView
                        style="@style/DemoIcon"
                        android:contentDescription="Ambulante"
                        android:src="@drawable/ic_truck"
                        app:tint="@color/brand_700" />

                    <TextView
                        style="@style/DemoLabel"
                        android:text="Ambulante" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardEmpresa"
                    style="@style/DemoCard"
                    android:layout_marginStart="5dp">

                    <ImageView
                        style="@style/DemoIcon"
                        android:contentDescription="Empresa"
                        android:src="@drawable/ic_leaf_small"
                        app:tint="@color/brand_700" />

                    <TextView
                        style="@style/DemoLabel"
                        android:text="Empresa" />

                </LinearLayout>

            </LinearLayout>

            <!-- Senha de demonstração -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Senha de demonstração: 12345"
                android:textColor="@color/ink_500"
                android:textSize="11sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Círculo maior -->

    <View
        android:id="@+id/decoracaoCirculoGrande"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="-35dp"
        android:layout_marginEnd="-25dp"
        android:alpha="0.85"
        android:background="@drawable/bg_circle_large"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Círculo menor -->

    <View
        android:id="@+id/decoracaoCirculoPequeno"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="-15dp"
        android:layout_marginEnd="-10dp"
        android:alpha="0.9"
        android:background="@drawable/bg_circle_small"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>