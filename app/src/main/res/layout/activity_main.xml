<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_screen"
    tools:context=".MainActivity">


    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="42dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">


            <!-- =====================================================
                 LOGO
                 ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="Logo do Coletaí"
                    android:elevation="8dp"
                    android:src="@drawable/logo_coletai" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coletaí"
                        android:textColor="@color/ink_900"
                        android:textSize="25sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.08"
                        android:text="DESCARTE CONSCIENTE"
                        android:textColor="@color/ink_500"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- =====================================================
                 APRESENTAÇÃO
                 ===================================================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="38dp"
                android:background="@drawable/bg_kicker"
                android:drawableStart="@drawable/ic_leaf_small"
                android:drawablePadding="7dp"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="Tecnologia para um futuro limpo"
                android:textColor="@color/brand_800"
                android:textSize="11sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:lineSpacingExtra="2dp"
                android:text="Bom ter você\npor aqui."
                android:textColor="@color/ink_900"
                android:textSize="30sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Acesse sua conta para solicitar ou realizar uma coleta."
                android:textColor="@color/ink_500"
                android:textSize="14sp" />


            <!-- =====================================================
                 EMAIL
                 ===================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="E-mail"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="seu@email.com"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="15sp" />


            <!-- =====================================================
                 SENHA
                 ===================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Senha"
                android:textColor="@color/ink_700"
                android:textSize="13sp"
                android:textStyle="bold" />


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input">


                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingStart="17dp"
                    android:paddingEnd="54dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="15sp" />


                <ImageButton
                    android:id="@+id/btnMostrarSenha"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:alpha="0.55"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar ou ocultar senha"
                    android:padding="14dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/ink_500" />

            </FrameLayout>


            <!-- =====================================================
                 BOTÃO ENTRAR
                 ===================================================== -->

            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:elevation="5dp"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />


            <!-- =====================================================
                 DIVISÓRIA
                 ===================================================== -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="30dp"
                android:background="@color/line" />


            <!-- =====================================================
                 CONTAS DE DEMONSTRAÇÃO
                 ===================================================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acesso rápido"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contas de demonstração"
                    android:textColor="@color/ink_500"
                    android:textSize="10sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">


                <!-- CLIENTE -->

                <LinearLayout
                    android:id="@+id/cardCliente"
                    style="@style/DemoCard"
                    android:layout_marginEnd="5dp">


                    <ImageView
                        style="@style/DemoIcon"
                        android:contentDescription="Cliente"
                        android:src="@drawable/ic_person"
                        app:tint="@color/brand_700" />


                    <TextView
                        style="@style/DemoLabel"
                        android:text="Cliente" />

                </LinearLayout>


                <!-- AMBULANTE -->

                <LinearLayout
                    android:id="@+id/cardAmbulante"
                    style="@style/DemoCard"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp">


                    <ImageView
                        style="@style/DemoIcon"
                        android:contentDescription="Ambulante"
                        android:src="@drawable/ic_truck"
                        app:tint="@color/brand_700" />


                    <TextView
                        style="@style/DemoLabel"
                        android:text="Ambulante" />

                </LinearLayout>


                <!-- EMPRESA -->

                <LinearLayout
                    android:id="@+id/cardEmpresa"
                    style="@style/DemoCard"
                    android:layout_marginStart="5dp">


                    <ImageView
                        style="@style/DemoIcon"
                        android:contentDescription="Empresa"
                        android:src="@drawable/ic_leaf_small"
                        app:tint="@color/brand_700" />


                    <TextView
                        style="@style/DemoLabel"
                        android:text="Empresa" />

                </LinearLayout>

            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Senha de demonstração: 12345"
                android:textColor="@color/ink_500"
                android:textSize="11sp" />


            <!-- =====================================================
                 BLUETOOTH - FICA MAIS ESCONDIDO NO FINAL
                 ===================================================== -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBluetoothDemo"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="28dp"
                android:alpha="0.75"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Bluetooth para demonstração"
                android:textAllCaps="false"
                android:textColor="@color/ink_500"
                android:textSize="11sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>