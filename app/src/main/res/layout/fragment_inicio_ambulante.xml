<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">
    <FrameLayout
        android:id="@+id/areaMapa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/painelOportunidades"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/texto_mapa_ilustrativo"
            android:scaleType="centerCrop"
            android:src="@drawable/mapa_cliente_bg" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_floating_control"
            android:padding="12dp"
            android:text="@string/texto_mapa_ilustrativo"
            android:textColor="@color/ink_900"
            android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisponibilidade"
            android:gravity="center" android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:text="@string/disponivel"
            android:textAllCaps="false"
            app:cornerRadius="24dp" />
    </FrameLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/painelOportunidades"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="220dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/texto_solicitacoes_de_coleta"
                android:textColor="@color/ink_900"
                android:textSize="20sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/layoutPedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txtPedidoRecebido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_history_card"
                    android:padding="16dp"
                    android:text="@string/sem_pedidos"
                    android:textColor="@color/ink_900"
                    android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutIndisponivel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:text="@string/texto_ative_sua_disponibilidade_para_consultar_os_p"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
