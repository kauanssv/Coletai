<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/workRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/workToolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="Coletaí" app:titleTextColor="@color/ink_900" android:background="@color/white" />
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <LinearLayout android:id="@+id/workContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F7F5">
   <TextView android:id="@+id/workTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingTop="16dp" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink_900" />
   <TextView android:id="@+id/workHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingVertical="8dp" android:textColor="@color/ink_500" />
   <com.google.android.material.chip.ChipGroup android:id="@+id/workHistoryFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:visibility="gone" app:singleSelection="true" app:selectionRequired="true" />
   <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/workList" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:clipToPadding="false" />
    <androidx.core.widget.NestedScrollView android:id="@+id/workScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:padding="20dp" android:clipToPadding="false"><LinearLayout android:id="@+id/workBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></androidx.core.widget.NestedScrollView>
    <TextView android:id="@+id/workEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="32dp" android:gravity="center" android:textColor="@color/ink_500" />
   </FrameLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/workMapCard" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
   <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <FrameLayout android:id="@+id/workMapContainer" android:layout_width="match_parent" android:layout_height="match_parent" />
    <com.google.android.material.button.MaterialButton android:id="@+id/workLocation" android:gravity="center" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_gravity="top|start" android:layout_margin="16dp" android:maxWidth="260dp" android:maxLines="1" android:ellipsize="end" android:text="Localizando…" android:textColor="@color/ink_900" app:backgroundTint="@color/white" app:cornerRadius="28dp" app:icon="@drawable/ic_location_small" app:iconTint="@color/brand_700" />
    <com.google.android.material.button.MaterialButton android:id="@+id/workNotices" android:gravity="center" android:textAllCaps="false" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="top|end" android:layout_margin="16dp" android:contentDescription="Notificações" app:icon="@drawable/ic_bell" app:iconTint="@color/ink_900" app:iconPadding="0dp" app:iconGravity="textStart" android:padding="14dp" app:cornerRadius="28dp" app:backgroundTint="@color/white" />
    <com.google.android.material.button.MaterialButton android:id="@+id/workExplore" android:gravity="center" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="bottom|end" android:layout_marginEnd="16dp" android:layout_marginBottom="64dp" android:text="Explorar mapa" app:icon="@drawable/ic_map" app:backgroundTint="@color/white" android:textColor="@color/brand_700" app:iconTint="@color/brand_700" app:cornerRadius="24dp" />
    <View android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="bottom" android:background="@drawable/bg_map_fade" android:importantForAccessibility="no" />
   </FrameLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="12dp" android:paddingBottom="20dp" android:background="@color/white">
    <FrameLayout android:id="@+id/workOrderPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/workGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OLÁ, CLIENTE" android:textSize="12sp" android:letterSpacing="0.08" android:textStyle="bold" android:textColor="@color/brand_700" />
    <TextView android:id="@+id/workQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="O que deseja descartar hoje?" android:textColor="@color/ink_900" android:textSize="21sp" android:textStyle="bold" />
    <com.google.android.material.button.MaterialButton android:id="@+id/workAction" android:gravity="center" android:textAllCaps="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:text="Fazer pedido" android:textSize="16sp" android:textStyle="bold" app:cornerRadius="14dp" app:backgroundTint="@color/brand_700" />
    <TextView android:id="@+id/workOrders" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="8dp" android:gravity="center_vertical" android:textColor="@color/ink_500" android:textSize="13sp" />
    <LinearLayout android:id="@+id/workOpportunities" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
   </LinearLayout>
  </LinearLayout>
 </FrameLayout>
 <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/workNavigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:backgroundTint="@color/white" app:labelVisibilityMode="labeled" app:menu="@menu/workspace_navigation" />
</LinearLayout>
