<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8">


    <!-- =====================================================
         PERFIL
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="26dp">


            <!-- CABEÇALHO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/texto_conta_profissional"
                android:textColor="@color/brand_700"
                android:textSize="11sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/texto_perfil"
                android:textColor="@color/ink_900"
                android:textSize="28sp"
                android:textStyle="bold" />


            <!-- PERFIL PRINCIPAL -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <!-- AVATAR -->

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp">


                        <TextView
                            android:id="@+id/txtAvatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_demo_icon"
                            android:gravity="center"
                            android:text="@string/texto_js"
                            android:textColor="@color/brand_700"
                            android:textSize="21sp"
                            android:textStyle="bold" />


                        <FrameLayout
                            android:id="@+id/btnFotoPerfil"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_button_primary"
                            android:clickable="true"
                            android:focusable="true">


                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/texto_alterar_foto"
                                android:src="@drawable/ic_camera"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                    </FrameLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/txtNomePrincipal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_joao_santos"
                            android:textColor="@color/ink_900"
                            android:textSize="17sp"
                            android:textStyle="bold" />


                        <TextView android:id="@+id/profileEmailHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/texto_ambulante_gmail_com"
                            android:textColor="@color/ink_500"
                            android:textSize="13sp" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="#EAF5EE"
                            android:paddingStart="9dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="4dp"
                            android:text="@string/texto_ambulante"
                            android:textColor="@color/brand_700"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ESTATÍSTICAS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="15dp"
                android:orientation="horizontal">


                <!-- AVALIAÇÃO -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/brand_700"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_4_9"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/texto_avaliacao"
                            android:textColor="#BDE3D2"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- COLETAS -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_10"
                            android:textColor="@color/ink_900"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/texto_coletas"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- GANHOS -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_r_262_2"
                            android:textColor="@color/ink_900"
                            android:textSize="17sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/texto_ganhos"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- DADOS PESSOAIS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:layout_marginBottom="8dp"
                android:text="@string/texto_dados_pessoais"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <!-- NOME -->

                    <LinearLayout
                        android:id="@+id/rowNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_nome"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtNome"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/texto_joao_santos"
                            android:textColor="@color/ink_700"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6" />


                    <!-- CPF -->

                    <LinearLayout
                        android:id="@+id/rowCpf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_cpf"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />

                        <TextView android:id="@+id/profileDocumentBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/texto_987_654_321_00"
                            android:textColor="@color/ink_700"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6" />


                    <!-- TELEFONE -->

                    <LinearLayout
                        android:id="@+id/rowTelefone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_telefone"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtTelefone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/texto_11_98888_5678"
                            android:textColor="@color/ink_700"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6" />


                    <!-- EMAIL -->

                    <LinearLayout
                        android:id="@+id/rowEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_e_mail"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />

                        <TextView android:id="@+id/profileEmailBody"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/texto_ambulante_gmail_com"
                            android:textColor="@color/ink_700"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F3F4F6" />


                    <!-- SENHA -->

                    <LinearLayout
                        android:id="@+id/rowSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_senha"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/texto_simbolo_5"
                            android:textColor="@color/ink_700"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- SAIR -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSair"
                android:gravity="center" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="50dp"
                android:layout_marginTop="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/texto_sair_da_conta"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FEF2F2"
                app:cornerRadius="12dp"
                app:strokeColor="#FECACA"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



    <!-- =====================================================
         EDITAR PERFIL
         ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutEdicao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9F8"
        android:orientation="vertical"
        android:visibility="gone">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">


            <TextView
                android:id="@+id/btnFecharEdicao"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_demo_icon"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/texto_simbolo_6"
                android:textColor="@color/ink_700"
                android:textSize="22sp" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/texto_editar_perfil"
                android:textColor="@color/ink_900"
                android:textSize="16sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/btnSalvarPerfil"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/texto_salvar"
                android:textColor="@color/brand_700"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/texto_nome_completo"
                    android:textColor="@color/ink_700"
                    android:textSize="11sp"
                    android:textStyle="bold"     android:labelFor="@id/edtNome" />


                <EditText
                    android:id="@+id/edtNome"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:inputType="textCapWords"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="@string/texto_joao_santos"
                    android:textColor="@color/ink_900"
                    android:textSize="14sp"     android:importantForAutofill="no"     android:maxLength="500" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="@string/texto_telefone_2"
                    android:textColor="@color/ink_700"
                    android:textSize="11sp"
                    android:textStyle="bold"     android:labelFor="@id/edtTelefone" />


                <EditText
                    android:id="@+id/edtTelefone"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:inputType="phone"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="@string/texto_11_98888_5678"
                    android:textColor="@color/ink_900"
                    android:textSize="14sp"     android:importantForAutofill="no"     android:maxLength="500" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="@string/texto_cpf"
                    android:textColor="@color/ink_700"
                    android:textSize="11sp"
                    android:textStyle="bold"     android:labelFor="@id/edtCpf" />


                <EditText
                    android:id="@+id/edtCpf"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:enabled="false"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="@string/texto_987_654_321_00"
                    android:textColor="#9CA3AF"
                    android:textSize="14sp"     android:inputType="number"     android:importantForAutofill="no"     android:maxLength="500" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>