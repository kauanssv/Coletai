<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8">

    <!-- =====================================================
         PERFIL - VISUALIZAÇÃO
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SUA CONTA"
                android:textColor="@color/brand_700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Perfil"
                android:textColor="@color/ink_900"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- CARTÃO DO USUÁRIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_history_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp">

                    <TextView
                        android:id="@+id/txtAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="start|top"
                        android:background="@drawable/bg_demo_icon"
                        android:gravity="center"
                        android:text="LF"
                        android:textColor="@color/brand_700"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFotoPerfil"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="end|bottom"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✎"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomeCabecalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lucas Ferreira"
                        android:textColor="@color/ink_900"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEmailCabecalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="cliente@gmail.com"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_kicker"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="Cliente"
                        android:textColor="@color/brand_700"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- DADOS PESSOAIS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.08"
                android:text="DADOS PESSOAIS"
                android:textColor="@color/ink_500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowNome"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nome completo"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtNomePerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="180dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Lucas Ferreira"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowCpf"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CPF"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtCpfPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123.456.789-00"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Telefone"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtTelefonePerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(11) 99999-1234"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="E-mail"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtEmailPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="175dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="cliente@gmail.com"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowSenha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Senha"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="••••••••"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ENDEREÇOS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.08"
                android:text="ENDEREÇOS"
                android:textColor="@color/ink_500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowEnderecoCasa"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Casa"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtEnderecoCasa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Rua das Flores, 234"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowEnderecoTrabalho"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Trabalho"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtEnderecoTrabalho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Av. Paulista, 1578"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="›"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowAdicionarEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="@color/brand_700"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adicionar endereço"
                        android:textColor="@color/brand_700"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnSairConta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="Sair da conta"
                android:textAllCaps="false"
                android:textColor="#DC2626"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FEF2F2" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- =====================================================
         PERFIL - EDIÇÃO
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F9F8"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/btnVoltarEdicao"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_demo_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="@color/ink_700"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Editar perfil"
                    android:textColor="@color/ink_900"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Salvar"
                    android:textColor="@color/brand_700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOME COMPLETO"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNomePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nome completo"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="TELEFONE"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTelefonePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="(11) 99999-9999"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CPF"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCpfPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:enabled="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_400"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="E-MAIL"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtEmailPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:enabled="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_400"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="CPF e e-mail ficam bloqueados nesta versão do MVP."
                    android:textColor="@color/ink_500"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
