<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8">

    <!-- =====================================================
         PERFIL - VISUALIZAÇÃO
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/texto_sua_conta"
                android:textColor="@color/brand_700"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/texto_perfil"
                android:textColor="@color/ink_900"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- CARTÃO DO USUÁRIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_history_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp">

                    <TextView
                        android:id="@+id/txtAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="start|top"
                        android:background="@drawable/bg_demo_icon"
                        android:gravity="center"
                        android:text="@string/texto_lf"
                        android:textColor="@color/brand_700"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFotoPerfil"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="end|bottom"
                        android:background="@drawable/bg_button_primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/texto_simbolo_9"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNomeCabecalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_lucas_ferreira"
                        android:textColor="@color/ink_900"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEmailCabecalho"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/texto_cliente_gmail_com"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_kicker"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="@string/texto_cliente"
                        android:textColor="@color/brand_700"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- DADOS PESSOAIS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.08"
                android:text="@string/texto_dados_pessoais"
                android:textColor="@color/ink_500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texto_nome_completo_2"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtNomePerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="180dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/texto_lucas_ferreira"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowCpf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texto_cpf"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtCpfPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_123_456_789_00"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texto_telefone"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtTelefonePerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_11_99999_1234"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texto_e_mail"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtEmailPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="175dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/texto_cliente_gmail_com"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/texto_senha"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_simbolo_5"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ENDEREÇOS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.08"
                android:text="@string/texto_enderecos"
                android:textColor="@color/ink_500"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_history_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowEnderecoCasa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_casa"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtEnderecoCasa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/texto_rua_das_flores_234"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowEnderecoTrabalho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="58dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_trabalho"
                        android:textColor="@color/ink_500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtEnderecoTrabalho"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/texto_av_paulista_1578"
                        android:textColor="@color/ink_900"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/texto_simbolo_10"
                        android:textColor="@color/ink_400"
                        android:textSize="21sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/rowAdicionarEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="50dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_simbolo_11"
                        android:textColor="@color/brand_700"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_adicionar_endereco"
                        android:textColor="@color/brand_700"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnSairConta"
                android:gravity="center" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="50dp"
                android:layout_marginTop="20dp"
                android:text="@string/texto_sair_da_conta"
                android:textAllCaps="false"
                android:textColor="#DC2626"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FEF2F2" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- =====================================================
         PERFIL - EDIÇÃO
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F7F9F8"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@android:color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/btnVoltarEdicao"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_demo_icon"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/texto_simbolo_6"
                    android:textColor="@color/ink_700"
                    android:textSize="23sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/texto_editar_perfil"
                    android:textColor="@color/ink_900"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/texto_salvar"
                    android:textColor="@color/brand_700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/texto_nome_completo"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold"     android:labelFor="@id/edtNomePerfil" />

                <EditText
                    android:id="@+id/edtNomePerfil"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/texto_nome_completo_2"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="14sp"     android:importantForAutofill="no"     android:maxLength="500" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/texto_telefone_2"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold"     android:labelFor="@id/edtTelefonePerfil" />

                <EditText
                    android:id="@+id/edtTelefonePerfil"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/texto_11_99999_9999"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="14sp"     android:importantForAutofill="no"     android:maxLength="500" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/texto_cpf"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold"     android:labelFor="@id/edtCpfPerfil" />

                <EditText
                    android:id="@+id/edtCpfPerfil"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:enabled="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_400"
                    android:textSize="14sp"     android:inputType="number"     android:importantForAutofill="no"     android:maxLength="500" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/texto_e_mail_2"
                    android:textColor="@color/ink_700"
                    android:textSize="12sp"
                    android:textStyle="bold"     android:labelFor="@id/edtEmailPerfil" />

                <EditText
                    android:id="@+id/edtEmailPerfil"
                    android:gravity="start|center_vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:enabled="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_400"
                    android:textSize="14sp"     android:inputType="textEmailAddress"     android:importantForAutofill="no"     android:maxLength="500" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/texto_cpf_e_e_mail_ficam_bloqueados_nesta_versao_do"
                    android:textColor="@color/ink_500"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
