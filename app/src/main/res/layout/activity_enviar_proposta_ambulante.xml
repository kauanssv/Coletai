<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8">


    <!-- =====================================================
         CABEÇALHO
         ===================================================== -->

    <LinearLayout
        android:id="@+id/cabecalho"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="62dp"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_demo_icon"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/texto_simbolo"
            android:textColor="@color/ink_700"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/texto_enviar_proposta_2"
            android:textColor="@color/ink_900"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


    <View
        android:id="@+id/divisorCabecalho"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        app:layout_constraintTop_toBottomOf="@id/cabecalho"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- =====================================================
         CONTEÚDO
         ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/divisorCabecalho"
        app:layout_constraintBottom_toTopOf="@id/rodape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">


            <!-- =================================================
                 RESUMO DO PEDIDO
                 ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">


                    <TextView
                        android:id="@+id/txtEmoji"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="@string/texto_simbolo_4"
                        android:textSize="24sp" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/txtResumoPedido"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/texto_eletronicos_14_kg"
                            android:textColor="@color/ink_900"
                            android:textSize="13sp"
                            android:textStyle="bold" />


                        <TextView
                            android:id="@+id/txtLocalizacao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/texto_consolacao_sao_paulo"
                            android:textColor="@color/ink_500"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



            <!-- =================================================
                 PREÇO
                 ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.05"
                android:text="@string/texto_seu_preco"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/texto_r"
                        android:textColor="#6B7280"
                        android:textSize="16sp"
                        android:textStyle="bold"     android:labelFor="@id/edtPreco" />


                    <EditText
                        android:id="@+id/edtPreco"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="@string/texto_0_00"
                        android:inputType="numberDecimal"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/ink_900"
                        android:textColorHint="#D1D5DB"
                        android:textSize="22sp"
                        android:textStyle="bold"     android:importantForAutofill="no"     android:maxLength="16" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>



            <!-- =================================================
                 MENSAGEM
                 ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.05"
                android:text="@string/texto_mensagem_para_o_cliente"
                android:textColor="#374151"
                android:textSize="12sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">


                <EditText
                    android:id="@+id/edtMensagem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="@string/texto_ex_posso_ir_em_30_minutos_trabalho_na_regiao"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:padding="14dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp"     android:importantForAutofill="no"     android:maxLength="500" />

            </com.google.android.material.card.MaterialCardView>



            <!-- =================================================
                 AVISO
                 ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#EAF5EE"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp">


                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@string/texto_informacao"
                        android:src="@drawable/ic_leaf_small"
                        app:tint="@color/brand_700" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/texto_ao_enviar_voce_se_compromete_a_coletar_pelo_v"
                        android:textColor="@color/brand_700"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>



    <!-- =====================================================
         BOTÃO INFERIOR
         ===================================================== -->

    <LinearLayout
        android:id="@+id/rodape"
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:minHeight="82dp"
        android:background="@android:color/white"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarProposta"
            android:gravity="center" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/texto_enviar_proposta"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_700"
            app:cornerRadius="13dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>