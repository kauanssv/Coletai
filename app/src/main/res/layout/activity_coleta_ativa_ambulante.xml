<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8">


    <!-- =====================================================
         COLETA ATIVA
         ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutColetaAtiva"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <!-- =================================================
             CABEÇALHO
             ================================================= -->

        <LinearLayout
            android:id="@+id/cabecalho"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_demo_icon"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#374151"
                android:textSize="30sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Coleta ativa"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#EAF5EE"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="6dp"
                    android:text="Em coleta"
                    android:textColor="#1F7A4D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- =================================================
             MAPA
             ================================================= -->

        <FrameLayout
            android:id="@+id/areaMapa"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toBottomOf="@id/cabecalho"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Mapa da coleta"
                android:scaleType="centerCrop"
                android:src="@drawable/mapa_cliente_bg" />


            <!-- ROTA SIMULADA -->

            <View
                android:layout_width="145dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="#1F7A4D"
                android:rotation="-28"
                android:alpha="0.80" />


            <!-- COLETOR -->

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_location_pulse">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_current_location"
                    android:contentDescription="Ambulante"
                    android:padding="5dp"
                    android:src="@drawable/ic_truck"
                    app:tint="@android:color/white" />

            </FrameLayout>


            <!-- DESTINO -->

            <ImageView
                android:layout_width="34dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="95dp"
                android:layout_marginTop="35dp"
                android:contentDescription="Destino"
                android:src="@drawable/ic_map_pin" />

        </FrameLayout>


        <!-- =================================================
             CONTEÚDO
             ================================================= -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollConteudo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="105dp"
            app:layout_constraintTop_toBottomOf="@id/areaMapa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- =========================================
                     ENDEREÇO COMPLETO
                     ========================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="ENDEREÇO COMPLETO"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="11dp"
                            android:gravity="top"
                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Endereço"
                                android:src="@drawable/ic_location_small"
                                app:tint="#1F7A4D" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:orientation="vertical">


                                <TextView
                                    android:id="@+id/txtEnderecoCompleto"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Localização atual do cliente"
                                    android:textColor="#111827"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />


                                <TextView
                                    android:id="@+id/txtRegiao"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Consolação, São Paulo — SP"
                                    android:textColor="#6B7280"
                                    android:textSize="13sp" />


                                <TextView
                                    android:id="@+id/txtObservacao"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="💬 Observação do cliente"
                                    android:textColor="#D97706"
                                    android:textSize="12sp"
                                    android:visibility="gone" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================================
                     CLIENTE
                     ========================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="15dp">


                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_demo_icon"
                            android:gravity="center"
                            android:text="LF"
                            android:textColor="#1F7A4D"
                            android:textSize="13sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lucas"
                                android:textColor="#111827"
                                android:textSize="14sp"
                                android:textStyle="bold" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Cliente"
                                android:textColor="#6B7280"
                                android:textSize="12sp" />

                        </LinearLayout>


                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_demo_icon">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="☎"
                                android:textColor="#1F7A4D"
                                android:textSize="20sp" />

                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================================
                     PEDIDO
                     ========================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="15dp">


                        <TextView
                            android:id="@+id/txtEmoji"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="💻"
                            android:textSize="24sp" />


                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">


                            <TextView
                                android:id="@+id/txtTipoPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Eletrônicos · 5 kg"
                                android:textColor="#111827"
                                android:textSize="13sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/txtDescricao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Notebook antigo e dois celulares quebrados"
                                android:textColor="#6B7280"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- =========================================
                     PREÇO ACEITO
                     ========================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#EAF5EE"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Valor da coleta"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/txtValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 45,00"
                            android:textColor="#1F7A4D"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!-- =================================================
             BOTÃO DE AÇÃO
             ================================================= -->

        <LinearLayout
            android:id="@+id/rodape"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:background="@android:color/white"
            android:elevation="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcaoColeta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🚚  Iniciar deslocamento"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#1F7A4D"
                app:cornerRadius="13dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <!-- =====================================================
         COLETA FINALIZADA
         ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutFinalizada"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F9F8"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">


        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_demo_icon">


            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Finalizado"
                android:src="@drawable/ic_check"
                app:tint="#1F7A4D" />

        </FrameLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Coleta finalizada!"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Obrigado por ajudar o meio ambiente. O descarte correto faz diferença 🌿"
            android:textColor="#6B7280"
            android:textSize="14sp" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="17dp">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Valor ganho"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/txtValorFinal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ 45,00"
                    android:textColor="#1F7A4D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoltarInicio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Voltar ao início"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#1F7A4D"
            app:cornerRadius="13dp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>