<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- =====================================================
         BLUETOOTH
         ===================================================== -->

    <!-- Android 11 e anteriores -->

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />


    <!-- Android 12 ou superior -->

    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />


    <!-- O app continua funcionando mesmo sem Bluetooth -->

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coletaí">


        <!-- =================================================
             LOGIN
             ================================================= -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Coletaí.Splash"
            android:windowSoftInputMode="adjustResize">


            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- =================================================
             BLUETOOTH
             ================================================= -->

        <activity
            android:name=".BluetoothActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- =================================================
             CLIENTE
             ================================================= -->

        <activity
            android:name=".tela_inicial_cliente"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".historico_cliente"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- =================================================
             AMBULANTE
             ================================================= -->

        <activity
            android:name=".tela_inicial_ambulante"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- =================================================
             EMPRESA
             ================================================= -->

        <activity
            android:name=".tela_inicial_empresa"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- =================================================
             TELAS COMPARTILHADAS
             ================================================= -->

        <activity
            android:name=".detalhes_pedido_ambulante"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".enviar_proposta_ambulante"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".coleta_ativa_ambulante"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


    </application>

</manifest>